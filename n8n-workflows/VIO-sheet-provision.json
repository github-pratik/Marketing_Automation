    {
      "parameters": {
        "jsCode": "// Header row for the System tab — the liveness board staff glance at.\n//\n// This tab holds NO lead data. It is one row per scheduled workflow, rewritten on every cycle, so\n// a human typing into the Inbox can tell \"working, nothing to do\" from \"dead\". Both schedules are\n// silent when idle — the mapper's chain stops at the sheet read when nothing is claimable — so\n// without this the two states look identical from inside the spreadsheet.\n//\n// A Sheets append bootstraps the header row when the tab is empty, which is the only way to\n// create one: an append on a tab with NO header matches nothing, writes nothing, and returns 200.\nreturn [{ json: { workflow: '', last_run_at: '', checked: '', waiting: '',\n                  last_result: '', every: '', next_check_at: '' } }];"
      },
