    {
      "parameters": {
        "jsCode": "// Report what the tab ACTUALLY holds. The sheet audit derives its header list from the data\n// rows, so an empty tab reports zero headers whether or not a header row exists — which is how a\n// completely unprovisioned Inbox went unnoticed. Reading back a row we just wrote is the only\n// honest proof that the header row is there and correctly named.\nconst WANT = ['status','notes','mapped_lead_id','Product','First name','Last name','Company name','Email address','Website'];\nconst rows = $input.all().map((i) => i.json || {});\nconst headers = [...new Set(rows.flatMap((r) => Object.keys(r)))].filter((k) => k !== 'row_number');\nconst missing = WANT.filter((h) => !headers.includes(h));\nreturn [{ json: {\n  ok: missing.length === 0 && rows.length > 0,\n  rows_in_inbox: rows.length,\n  headers_present: headers,\n  headers_missing: missing,\n  product_column_exists: headers.includes('Product'),\n  newest_row: rows.length ? rows[rows.length - 1] : null,\n  at: new Date().toISOString(),\n} }];"
      },
      "id": "vio-rp-done",
      "name": "Report",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
