    {
      "parameters": {
        "jsCode": "// Same fail-closed gate every VIO webhook uses. This one writes into a tab staff type into.\nconst expected = $env.VIO_WEBHOOK_TOKEN;\nconst item = $input.item.json;\nconst q = item.query || {}; const h = item.headers || {};\nconst got = q.t || q.token || h['x-vio-token'];\nif (!expected) throw new Error('REFUSED: VIO_WEBHOOK_TOKEN not set (fail-closed)');\nif (!got || String(got) !== String(expected)) throw new Error('REFUSED: bad or missing token');\nconst b = item.body || {};\n// A caller may seed a test lead. Defaults are a clearly-fake lead at a domain nobody owns, so an\n// accidental run cannot mail a real person.\nreturn { json: {\n  status: '', notes: '', mapped_lead_id: '',\n  Product: b.Product || 'OryonIQ',\n  'First name': b.first_name || 'Wiring',\n  'Last name': b.last_name || 'Test',\n  'Company name': b.company || 'Wiring Test Co',\n  'Email address': b.email || 'wiring-test@example.invalid',\n  'Website': b.website || 'example.invalid',\n} };"
      },
      "id": "vio-rp-auth",
      "name": "Authenticate (fail-closed)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
