    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Read-only audit of the live spreadsheet. Exists because the schema DOC has been wrong twice:\n// source_config is documented as the product config but is really an arrival-channel dropdown,\n// and channel_state_email is documented as not_sent/queued/sent but is really a pipeline-stage\n// vocabulary. Guessing from the doc put invalid values into columns a human reads.\n//\n// Reports the headers each tab actually has, and the distinct values actually present in the\n// columns that turned out to be dropdowns \u2014 the live sheet, not the documentation, is the truth.\nconst TABS = [\"Leads\", \"Suppression\", \"Events\", \"Costs\", \"Segments\", \"Demo\", \"Inbox\", \"Pipeline\"];\nconst out = {};\nfor (const tab of TABS) {\n  let rows = [];\n  try { rows = $(`Read ${tab}`).all().map((i) => i.json || {}); } catch (e) { rows = null; }\n  if (rows === null) { out[tab] = { exists: false }; continue; }\n  const real = rows.filter((r) => Object.keys(r).some((k) => k !== 'row_number' && String(r[k] ?? '').trim()));\n  const headers = [...new Set(rows.flatMap((r) => Object.keys(r)))].filter((k) => k !== 'row_number');\n  const vals = {};\n  for (const col of headers) {\n    const seen = [...new Set(real.map((r) => String(r[col] ?? '').trim()).filter(Boolean))];\n    if (seen.length) vals[col] = seen.slice(0, 8);\n  }\n  out[tab] = { exists: true, header_count: headers.length, headers, data_rows: real.length, values: vals };\n}\nreturn [{ json: out }];\n"
      },
